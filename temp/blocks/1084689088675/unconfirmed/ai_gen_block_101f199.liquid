{% doc %}
  @prompt
    Create a diagonal “SOLD OUT” ribbon overlay across product images for products Shopify marks as sold out, such as when tracked inventory reaches zero. Show it on product cards in collection listings and search results, keep the ribbon readable on desktop and mobile, and leave in-stock product images unchanged. Do not change inventory, product availability, or purchasing behavior.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-soldout-ribbon-block-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-soldout-ribbon-{{ ai_gen_id }} {
    position: absolute;
    z-index: 4;
    top: 50%;
    left: 50%;
    width: 150%;
    padding: 10px 0;
    transform: translate(-50%, -50%) rotate(-35deg);
    background: {{ block.settings.ribbon_background }};
    color: {{ block.settings.ribbon_text_color }};
    font-family: inherit;
    font-size: clamp(12px, 2.5vw, {{ block.settings.font_size }}px);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-align: center;
    pointer-events: none;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .ai-soldout-ribbon-target-{{ ai_gen_id }} {
    position: relative !important;
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    .ai-soldout-ribbon-{{ ai_gen_id }} {
      padding: 7px 0;
      font-size: clamp(11px, 3vw, {{ block.settings.font_size }}px);
    }
  }
{% endstyle %}

<sold-out-ribbon-{{ ai_gen_id }}
  class="ai-soldout-ribbon-block-{{ ai_gen_id }}"
  data-ribbon-text="{{ block.settings.ribbon_text | escape }}"
  {{ block.shopify_attributes }}
></sold-out-ribbon-{{ ai_gen_id }}>

<script>
  (function() {
    var elementName = 'sold-out-ribbon-{{ ai_gen_id }}';
    if (customElements.get(elementName)) return;

    class SoldOutRibbon extends HTMLElement {
      connectedCallback() {
        this.ribbonText = this.dataset.ribbonText || 'SOLD OUT';
        this.applyToCards(document);
        this.observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            mutation.addedNodes.forEach((node) => {
              if (node.nodeType === 1) this.applyToCards(node);
            });
          });
        });
        this.observer.observe(document.body, { childList: true, subtree: true });
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
      }

      applyToCards(root) {
        var cards = [];
        if (root.matches && root.matches('.card-wrapper, .card')) cards.push(root);
        if (root.querySelectorAll) cards = cards.concat(Array.from(root.querySelectorAll('.card-wrapper, .card')));
        cards.forEach((card) => {
          if (card.querySelector('.ai-soldout-ribbon-{{ ai_gen_id }}')) return;
          var labels = card.querySelectorAll('.card__badge .badge, .card__badge span');
          var soldOut = Array.from(labels).some((label) => label.textContent.trim().toLowerCase() === 'sold out');
          if (!soldOut) return;
          var media = card.querySelector('.card__inner, .card__media');
          if (!media) return;
          media.classList.add('ai-soldout-ribbon-target-{{ ai_gen_id }}');
          var ribbon = document.createElement('span');
          ribbon.className = 'ai-soldout-ribbon-{{ ai_gen_id }}';
          ribbon.setAttribute('aria-label', this.ribbonText);
          ribbon.textContent = this.ribbonText;
          media.appendChild(ribbon);
        });
      }
    }

    customElements.define(elementName, SoldOutRibbon);
  })();
</script>

{% schema %}
{
  "name": "Sold-out image ribbon",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "text",
      "id": "ribbon_text",
      "label": "Ribbon text",
      "default": "SOLD OUT"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "ribbon_background",
      "label": "Ribbon background",
      "default": "#5D1619"
    },
    {
      "type": "color",
      "id": "ribbon_text_color",
      "label": "Ribbon text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Sold-out image ribbon"
    }
  ],
  "tag": null,
  "class": "sold-out-image-ribbon-block"
}
{% endschema %}