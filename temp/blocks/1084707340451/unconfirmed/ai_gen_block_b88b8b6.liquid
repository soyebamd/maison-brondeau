{% doc %}
  @prompt
    Create a standard, readable “SOLD OUT” badge overlay on the main product image/media gallery on individual product pages. Show the badge only when Shopify marks the product as sold out, hide it for available products, and make it responsive on mobile and desktop. Do not change collection product cards, inventory, or purchasing behavior., can it land right on the photo of the bottle
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sold-out-overlay-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    height: 100%;
    position: absolute;
    z-index: 5;
    inset: 0 auto auto 0;
    pointer-events: none;
  }

  .ai-sold-out-overlay-{{ ai_gen_id }}__badge {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    border: 1px solid {{ block.settings.badge_text_color }};
    font-family: inherit;
    font-size: clamp(14px, 2vw, {{ block.settings.font_size }}px);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .ai-sold-out-overlay-{{ ai_gen_id }}__badge {
      padding: 10px 16px;
      font-size: 14px;
    }
  }
{% endstyle %}

{% if product != blank and product.available == false %}
  <product-sold-out-overlay-{{ ai_gen_id }}
    class="ai-sold-out-overlay-{{ ai_gen_id }}"
    data-block-id="{{ ai_gen_id }}"
    {{ block.shopify_attributes }}
  >
    <span class="ai-sold-out-overlay-{{ ai_gen_id }}__badge" role="status">{{ block.settings.badge_text | escape }}</span>
  </product-sold-out-overlay-{{ ai_gen_id }}>

  <script>
    (function() {
      const tagName = 'product-sold-out-overlay-{{ ai_gen_id }}';
      if (customElements.get(tagName)) return;

      class ProductSoldOutOverlay extends HTMLElement {
        connectedCallback() {
          this.placeOnPhoto();
          this.observer = new MutationObserver(() => this.placeOnPhoto());
          this.observer.observe(document.documentElement, { childList: true, subtree: true });
        }

        disconnectedCallback() {
          if (this.observer) this.observer.disconnect();
        }

        placeOnPhoto() {
          const gallery = document.querySelector('product-media-gallery');
          if (!gallery) return;
          const photo = gallery.querySelector('.product__media-item .product__media') || gallery.querySelector('.product__media');
          if (!photo) return;
          if (photo.contains(this)) {
            if (this.observer) this.observer.disconnect();
            return;
          }
          if (getComputedStyle(photo).position === 'static') photo.style.position = 'relative';
          photo.appendChild(this);
          if (this.observer) this.observer.disconnect();
        }
      }

      customElements.define(tagName, ProductSoldOutOverlay);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Product sold out badge",
  "settings": [
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Sold out"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Badge font size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#5D1619"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Product sold out badge"
    }
  ],
  "tag": null,
  "class": "product-sold-out-badge-block"
}
{% endschema %}